import sys
 
def solve():
    data = sys.stdin.read().split('
')
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        n, k = map(int, data[idx].split()); idx += 1
        s = data[idx].strip(); idx += 1
        if 2 * k > n:
            out.append("-1")
            continue
        cost = 0
        for i in range(k):
            if s[i] != 'R':
                cost += 1
        for i in range(n - k, n):
            if s[i] != 'L':
                cost += 1
        out.append(str(cost))
    print('
'.join(out))
 
solve()